{
  "name": {
    "en": "Car status",
    "no": "Bilstatus"
  },
  "height": 180,
  "settings": [],
  "devices": {
    "type": "app",
    "singular": true,
    "filter": {
      "class": "car"
    }
  },
  "api": {
    "getChargerState": {
